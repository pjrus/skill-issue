rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Schema validation for a User document
    function isValidUser(data) {
      // Required fields
      return data.username is string
        && data.fullName is string
        && data.email is string
        && data.avatarUrl is string
        && data.skillsOffered is list
        && data.skillsWanted is list
        && data.learningStyle is list
        // Optional fields: if they exist, they must be the correct type
        && (!('bio' in data) || data.bio is string)
        && (!('availability' in data) || data.availability is string)
        && (!('preferredModel' in data) || data.preferredModel is string);
    }

    // Schema validation for an Appointment document
    function isValidAppointment(data) {
      return data.matchId is string
        && data.userIds is list
        && data.date is timestamp
        && data.status is string
        && (data.status == 'scheduled' || data.status == 'completed' || data.status == 'cancelled')
        && data.teachingSkill is string
        && data.learningSkill is string
        // meetLink is optional
        && (!('meetLink' in data) || data.meetLink is string);
    }

    // Schema validation for a Review document
    function isValidReview(data) {
      return data.bookingId is string
        && data.reviewerId is string
        && data.revieweeId is string
        && data.reviewText is string
        && data.rating is int
        && data.rating >= 1 && data.rating <= 5
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      // CREATE: Allow if user is authenticated (for seeding) OR is creating their own profile.
      // This allows the seed script to run, while still enforcing ownership for regular creation.
      allow create: if (isAuth() || isOwner(userId))
                      && isValidUser(request.resource.data)
                      && request.resource.data.keys().hasOnly(['username', 'fullName', 'email', 'avatarUrl', 'bio', 'skillsOffered', 'skillsWanted', 'learningStyle', 'availability', 'preferredModel']);

      // READ: Any authenticated user can read profiles for matching.
      allow get, list: if isAuth();

      // UPDATE: User can only update their own profile, maintaining schema integrity.
      // Email is immutable, and the final document must conform to the schema.
      allow update: if isOwner(userId) 
                      && request.resource.data.email == resource.data.email
                      && isValidUser(request.resource.data)
                      && request.resource.data.keys().hasOnly(['username', 'fullName', 'email', 'avatarUrl', 'bio', 'skillsOffered', 'skillsWanted', 'learningStyle', 'availability', 'preferredModel']);
    }

    match /appointments/{appointmentId} {
      // READ/UPDATE: User must be part of the appointment.
      allow read: if isAuth() && request.auth.uid in resource.data.userIds;
      allow update: if isAuth() 
                      && request.auth.uid in resource.data.userIds
                      && isValidAppointment(request.resource.data);
      
      // CREATE: User must be one of the participants, there must be exactly two participants,
      // and the new data must conform to the schema.
      allow create: if isAuth() 
                      && request.auth.uid in request.resource.data.userIds 
                      && request.resource.data.userIds.size() == 2
                      && isValidAppointment(request.resource.data);
    }

    match /mail/{mailId} {
      // Users can only create mail documents to trigger the extension.
      // They should not be able to read or modify them once sent for security.
      allow create: if isAuth();
    }

    match /reviews/{reviewId} {
      // READ: Any authenticated user can read reviews.
      allow read: if isAuth();

      // CREATE:
      // 1. User is authenticated and is the reviewer.
      // 2. Reviewer is not the reviewee (no self-reviews).
      // 3. Document ID must be unique per booking/reviewer (handled by being the ID).
      // 4. Data must be valid.
      // 5. Participants check: Both reviewer and reviewee must be in the booking.
      allow create: if isAuth() 
                       && request.auth.uid == request.resource.data.reviewerId
                       && request.resource.data.reviewerId != request.resource.data.revieweeId
                       && isValidReview(request.resource.data)
                       && reviewId == request.resource.data.bookingId + "_" + request.resource.data.reviewerId
                       && request.resource.data.reviewerId in get(/databases/$(database)/documents/appointments/$(request.resource.data.bookingId)).data.userIds
                       && request.resource.data.revieweeId in get(/databases/$(database)/documents/appointments/$(request.resource.data.bookingId)).data.userIds;
      
      // UPDATE/DELETE: Not allowed (reviews are immutable).
      allow update, delete: if false;
    }
  }
}
